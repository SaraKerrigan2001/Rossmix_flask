turn false;">No me interesa</a></div><p class="login-text">¿Ya eres suscriptor? <a onclick="mgr.libs.Zentral.login()">Inicia sesión</a></p><p class="text-1">Lee <i>{{artTitle}}</i> por un módico precio.</p><p class="claim-text"><a class="claim-link" href="/pagina/beneficios-registro.html#planes-suscripcion">Suscríbete ahora</a></p></div></div>`,blockerTemplate: ``,returnText: `No me interesa`,text: `Este contenido es <strong>exclusivo para suscriptores</strong>.`,partImg: ``,partImgTablet: ``,partText: ``,partClaim: `<a class="claim-link" href="https://tienda.rba.es/revistas/speakup/suscripcion/suscripcion-speakup?rba_source=speakup&rba_medium=referral&rba_campaign=spup-lanzamiento&rba_term=speakup&rba_content=popup-muro" data-google-interstitial="false" onclick="mgr.libs.Zentral.paywallClickAction(this); return false;" target="_blank">PRUEBA AHORA POR 1€</a>`,loginText: `¿Ya eres suscriptor? <a onClick="mgr.libs.Zentral.login()">Inicia sesión</a>`,}};window.mgr.cfg.zentralBookmarks = {template: ``,save: `Guardar`,saved: `Guardado`,webId: window.mgr.cfg.zentral.clientId,bookmarkApi: 'https://interwebs.mangiro.com/api/v1/zentralbookmark'};</script>
