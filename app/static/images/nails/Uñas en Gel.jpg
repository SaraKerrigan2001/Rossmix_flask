w-block.cw-accept{order:2;padding-right:0} .cw-block p{flex-grow:1;margin-bottom:24px;}}';let stylesModal = document.createElement('style');stylesModal.innerText = cssWindowModal + cssCookiesWall;document.body.appendChild(stylesModal);// textos de la ventana modal		const msgTitleIntro =  'Accede a los contenidos de Instyle';const msgIntro = 'Si eres suscriptor de InStyle Pass, <a href="https://www.instyle.es/zentral-externallogin.aspx">inicia sesión</a> ahora para navegar sin cookies.';const msgTitleAcceptCookies = 'ACEPTANDO LAS COOKIES';const msgAcceptCookies = 'Podrás acceder a nuestro contenido de forma gratuita con anuncios personalizados. Gracias a esta publicidad podemos seguir haciendo artículos, fotografías, vídeos y reportajes con la máxima calidad editorial.';const msgTitleSubscription = 'SUSCRIBIÉNDOTE';const msgSubscription = 'Tendrás acceso a todos los artículos de InStyle, así como del resto de webs del grupo RBA, sin necesidad de aceptar cookies.';const msgBtnAcceptCookies = 'Aceptar y cerrar';const msgBtnSubscription = 'Me suscribo por 1€/mes';const urlSubscription = 'https://tienda.rba.es/revistas/landing-rba-pass';// mostramos la ventana modallet divCookiesWall = `<div class="cookie-wall"><h2 class="cw-title">${msgTitleIntro}</h2><p class="cw-intro">${msgIntro}</p><div class="cw-content"><div class="cw-block cw-accept"><h3 class="cw-title">${msgTitleAcceptCookies}</h3><p>${msgAcceptCookies}</p><button id="cw-btn-accept">${msgBtnAcceptCookies}</button></div><div class="cw-block cw-subscription"><h3 class="cw-title">${msgTitleSubscription}</h3><p>${msgSubscription}</p><button id="cw-btn-subs">${msgBtnSubscription}</button></div></div></div>`;let asideModal = document.createElement("aside");asideModal.setAttribute('id', 'modal-window');asideModal.innerHTML = divCookiesWall;document.body.appendChild(asideModal);// Añadimos los eventos a los botoneslet btnAcceptCookies = document.getElementById('cw-btn-accept');btnAcceptCookies.addEventListener('click', function (event) {// Ocultamos la modal y aceptamos todas las cookies - Didomi Event Custom: Accept AllsetTimeout(() => { window.Didomi.setUserAgreeToAll(); }, 1);closeModalSubscription();});let btnSubscription = document.getElementById('cw-btn-subs');btnSubscription.addEventListener('click', function (event) {// Redirigimos a la url de suscripciónwindow.location.href = urlSubscription;});}function closeModalSubscription() {// ocultamos la ventana modalsetTimeout(() => { document.getElementById('modal-window').remove(); }, 1);//eliminamos classes de didomi del bodydocument.body.classList.remove('didomi-popup-open');document.body.classList.remove('didomi-popup-open-ios');}//Este evento tiene que ir fuera del didomiOnReady si lo queremos capturarwindow.didomiEventListeners = window.didomiEventListeners || [];var didomiNoticeShown = false;    window.didomiEventListeners.push({event: 'notice.shown',listener: function () {//salta cuando mostramos el popup de Didomi            didomiNoticeShown = true;         }});function _didomiEvents() {// Capturamos los eventos de Didomi			window.didomiEventListeners = window.didomiEventListeners || [];if (didomiNoticeShown) {// Añadimos botón personalizado como clonado del otro - Didomi didomiNoticeShown: Change btn rejectlet btnDisagreeAll = document.getElementById('didomi-notice-disagree-button');if (btnDisagreeAll == null) return;let newBtnDisagreeCustom = btnDisagreeAll.cloneNode(true);let btnAgreeAll = document.getElementById('didomi-notice-agree-button');// Ocultamos el didomi-notice-disagree-button de Didomi	y añadimos los estilos por defecto a Didomilet stylesCSS = document.createElement('style');stylesCSS.type = 'text/css';stylesCSS.innerHTML = '#didomi-host .didomi-popup-backdrop{background:rgba(0,0,0,.6) !important;} #didomi-host .didomi-popup-notice-optin-type .didomi-popup-notice-buttons .didomi-components-button{text-transform:uppercase;font-size:13px;line-height:16px;font-weight:700;padding:10px !important;} #buttons #didomi-notice-learn-more-button{background:#FFF !important;border-color:#004AAD !important;color:#00449F !important;} #buttons #didomi-notice-disagree-button {visibility: hidden; width: 0px; height: 0px; padding: 0; border: 0;} .hidden-button {display:none;} #didomi-host .didomi-components-button{text-transform:uppercase;font-size:13px;} #didomi-host a:hover{border:none;} @media only screen and (max-width: 767px) {#didomi-notice-agree-button {order:1;} #didomi-notice-learn-more-button{order:2;} #disagree-button-custom{order:3 !important;}} @media only screen and (min-width: 768px) {#didomi-notice-agree-button {order:3;} #didomi-notice-learn-more-button{order:2;} #disagree-button-custom{order:1 !important;} #didomi-host .didomi-popup-container .didomi-popup-notice-text{max-width:100%;}}';document.body.appendChild(stylesCSS);newBtnDisagreeCustom.setAttribute('id', 'disagree-button-custom');btnDisagreeAll.after(newBtnDisagreeCustom);btnDisagreeAll.className = "";btnDisagreeAll.style = "";// Assignamos los mismos estilos que el botón de aceptar al nuevo botónconst stylesAgree = window.getComputedStyle(btnAgreeAll, null);if (stylesAgree.cssText !== '') { // problema de compatibilidad con algunos navegadoresnewBtnDisagreeCustom.style.cssText = stylesAgree.cssText;} else {const cssText = Object.values(stylesAgree).reduce((css, propertyName) =>`${css}${propertyName}:${stylesAgree.getPropertyValue(propertyName)};`);newBtnDisagreeCustom.style.cssText = cssTextnewBtnDisagreeCustom.style.marginRight = "10px";}// Estilos con botón en fondo blanco y letra azul:/*const cssText = "background-color: #fff;color: rgb(0, 74, 173);border-color: rgb(0, 74, 173);";newBtnDisagreeCustom.style.cssText = cssText;*/// Añadimos un evento al nuevo botónnewBtnDisagreeCustom.addEventListener('click', function (event) {                // Ocultamos Didomi y mostramps la pantalla "nueva" de suscripciónshowModalSubscription();let divDidomi = document.getElementById('didomi-host');divDidomi.style.display = "none";});}window.didomiEventListeners.push({event: 'preferences.shown',listener: function () {                // Añadimos un Timeout para que de tiempo a cargar la pantalla de preferenciassetTimeout(function () {let btnPrefDisagreeAll = document.getElementById('btn-toggle-disagree');if (typeof btnPrefDisagreeAll == 'undefined') return;let newBtnPrefDisagreeCustom = btnPrefDisagreeAll.cloneNode(true);let btnPrefAgreeAll = document.getElementById('btn-toggle-agree');if (typeof btnPrefAgreeAll == 'undefined') return;newBtnPrefDisagreeCustom.setAttribute('id', 'disagree-preferences-button-custom');btnPrefDisagreeAll.after(newBtnPrefDisagreeCustom);btnPrefDisagreeAll.style.display = "none !important";btnPrefDisagreeAll.className = "hidden-button";// Assignamos los mismos estilos que el botón de aceptar al nuevo botón			const stylesPrefAgree = window.getComputedStyle(btnPrefAgreeAll, null);if (stylesPrefAgree.cssText !== '') { // problema de compatibilidad con algunos navegadoresnewBtnPrefDisagreeCustom.style.cssText = stylesPrefAgree.cssText;} else {const cssPrefText = Object.values(stylesPrefAgree).reduce((css, propertyName) =>`${css}${propertyName}:${stylesPrefAgree.getPropertyValue(propertyName)};`);newBtnPrefDisagreeCustom.style.cssText = cssPrefTextnewBtnPrefDisagreeCustom.style.marginRight = "10px";newBtnPrefDisagreeCustom.style.width = "auto";}// Añadimos un evento al nuevo botónnewBtnPrefDisagreeCustom.addEventListener('click', function (event) {// Ocultamos Didomi y mostramos la pantalla "nueva" de suscripción - Didomi Event Custom: clickshowModalSubscription();let divDidomi = document.getElementById('didomi-host');divDidomi.style.display = "none";});}, 500);}});}function crearAvisoTemporal() {const css = `.aviso-flotante-js {position: fixed;bottom: 140px;left: 50%;transform: translateX(-50%);background-color: #ffffff;color: #000000;font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;font-size: 14px;line-height: 1.5;padding: 20px 40px 20px 20px; /* Más padding a la derecha para que el texto no pise la cruz */width: 90%;max-width: 500px;box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);border:1px solid #000;border-radius: 4px;			z-index: 9999;box-sizing: border-box;transition: opacity 0.5s ease, visibility 0.5s ease;opacity: 1;visibility: visible;}.aviso-flotante-js.oculto {opacity: 0;visibility: hidden;}.cerrar-aviso-js {position: absolute;top: 12px;right: 10px;background: none;border: none;font-size: 22px;font-weight: normal;line-height: 1;color: #000;cursor: pointer;padding: 8px;transition: color 0.2s ease, transform 0.2s ease;background-image: url(data:image/svg+xml;base64,);background-repeat: no-repeat;}.cerrar-aviso-js:hover {color: #000000;}`;const styleTag = document.createElement("style");styleTag.textContent = css;document.head.appendChild(styleTag);const aviso = document.createElement("div");aviso.className = "aviso-flotante-js";// Nodo de textoconst textoNode = document.createTextNode("Queremos que conozcas InStyle. Por eso, puedes acceder a nuestros contenidos con las cookies rechazadas.");aviso.appendChild(textoNode);// Botón para la cruz de cierreconst botonCerrar = document.createElement("button");botonCerrar.className = "cerrar-aviso-js";//botonCerrar.innerHTML = "&times;"; // Entidad HTML para el símbolo de multiplicar (X)botonCerrar.setAttribute("aria-label", "Cerrar aviso");aviso.appendChild(botonCerrar);document.body.appendChild(aviso);let temporizadorId;function cerrarAviso() {// Si el usuario hace clic antes de los 5s, cancelamos la cuenta atrás automáticaif (temporizadorId) clearTimeout(temporizadorId); aviso.classList.add("oculto");// Esperamos a que termine la animación de desvanecimiento (0.5s) para limpiar el DOMsetTimeout(() => {aviso.remove();styleTag.remove();}, 500);}botonCerrar.addEventListener("click", cerrarAviso);// Programamos el cierre automático a los 5 segundostemporizadorId = setTimeout(cerrarAviso, 5000);}// Evento que salta al cargar Didomiwindow.didomiOnReady.push(function (Didomi) {const mgrCookie = mgr?.libs?.Cookie;const cookieNoChoiceName = 'mgr-no-choice';if (Didomi.notice.isVisible()) {// Si el usuario está logado o tiene la cookie "no-choice" rechazamos las cookies automáticamenteconst isLogged = typeof mgrCookie?.zentralCookieExists === 'function' && mgrCookie.zentralCookieExists();const hasNoChoiceCookie = typeof mgrCookie?.exists === 'function' && mgrCookie.exists(cookieNoChoiceName);//console.log("Didomi > isLogged = " + isLogged);//console.log("Didomi > hasNoChoiceCookie = " + hasNoChoiceCookie);if (isLogged || hasNoChoiceCookie) {//console.log("Didomi > Rechazamos automáticamente las cookies");mgrCookie?.remove(cookieNoChoiceName);Didomi.setUserDisagreeToAll(); // Cierra automáticamente Didomiif(!isLogged) crearAvisoTemporal();} else {//console.log("Didomi > Insertamos la cookie 'mgr-no-choice'"); mgrCookie?.set(cookieNoChoiceName, '1', 365, true);// Adjuntamos los eventos:_didomiEvents();}} else  mgrCookie?.remove(cookieNoChoiceName);// Call other functions on the SDKDidomi.getObservableOnUserConsentStatusForVendor('google').subscribe(function (consentStatus) {if (consentStatus === true) {// The user has given consent to the vendormgr.consent.google = 1;} else if (consentStatus === false) {// The user has denied consent to the vendormgr.consent.google = 0;} else if (consentStatus === undefined) {// The consent status for the vendor is unknownmgr.consent.google = -1;}                if (consentStatus !== undefined) {let eventAds = new CustomEvent("mgr-ads", { "detail": "Start ads" });document.dispatchEvent(eventAds);}});setTimeout(() => {let eventGTM = new CustomEvent("mgr-gtm-load", { "detail": "Load the GTM" });document.dispatchEvent(eventGTM);}, 100);});</script><script async src="/content/20260728143112/js/es/app.min.js"></script><!-- DIDOMI Consent --><link rel="canonical" href="https://www.instyle.es/belleza/unas-gel-todo-que-debes-saber-para-que-luzcan-perfectas_37700" /><script>var mgr = mgr || {};mgr.cfg = mgr.cfg || {};mgr.cfg.jwp = mgr.cfg.jwp || {"playerId":"TpOYKibq","related":{"active":true,"displayMode":"shelf","urlPlaylist":"https://cdn.jwplayer.com/v2/playlists/98Z78haj?related_media_id=U5NqEXOL","heading":"Ver más videos","autoplayMessage":"__title__ empezará en xx segundos","autoplayTimer":10,"onComplete":"autoplay"}};</script><script>var mgr = mgr || {};mgr.cfg = mgr.cfg || {};mgr.cfg.dym = mgr.cfg.dym || {"desktopPlayer":{"id":"xebq5","mute":true},"mobilePlayer":{"id":"xebq6","mute":true},"adminPlayer":{"id":"x134o4","mute":true},"videoObjectPlayer":{"id":"x1csn8","mute":true},"coverPlayer":{"id":"x1isr8","mute":true}};</script><script>window.mgr.cfg.zentral = {type: 'free_access',contentType: 'Gallery',clientId: 'in',issuer: 'https://id.instyle.es',profileUrl: 'https://mi.instyle.es',clientApiUrl: 'https://rights-zentral.rba.es',meteredMaxCount: '5',meteredExpireTime: '1',wallType: 'TotalBlocking',oidcStatus: 'false',oidcLoaded: 'false',isPayperIP: 'false'};window.mgr.cfg.zentral.templates = {login: `Iniciar Sesión`,loginTemplate: `<a id="user-profile" class="navbar-user-access" onClick="return mgr.libs.Zentral.login()" href="#"><img class="user-img" src="/content/img/wall/icon-loginOFF.svg" alt="user-profile" width="23" height="26"/><p class="user-txt">Iniciar Sesión</p></a>`,user: `Mi Perfil`,userTemplate: `<a id="user-profile" class="navbar-user-access logged" href="{{profileUrl}}?client={{clientId}}&origin={{href}}"><img class="user-img" src="/content/img/wall/icon-login.svg" alt="user-profile" width="23" height="26"/><p class="user-txt" title="{{name}}">{{name}}</p></a>`,menu: {login: `Registrate / Inicia sesión`,loginTemplate: `