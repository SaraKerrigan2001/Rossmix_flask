# ============================================================
# Rossmix Flask — Variables de entorno
# Copia este archivo a .env y rellena los valores reales
# NUNCA subas .env al repositorio
# ============================================================

# ── General ──────────────────────────────────────────────────
SECRET_KEY=cambia_esto_por_una_clave_muy_larga_y_aleatoria
FLASK_ENV=production

# Duración de sesión en segundos (por defecto 8 horas)
SESSION_LIFETIME_SECONDS=28800

# ── Base de datos PostgreSQL ──────────────────────────────────
# Opción A: variables separadas (para desarrollo local sin Docker)
DB_USER=postgres
DB_PASSWORD=pon_tu_contraseña_aqui
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Rossmix

# Opción B: URL completa (Docker la sobreescribe automáticamente)
# DATABASE_URL=postgresql+psycopg://postgres:password@db:5432/Rossmix

# Puerto en el host donde se expone PostgreSQL desde Docker
# Cambiar si el 5432 está ocupado en tu máquina
DB_PORT_EXPOSED=5432

# ── Correo electrónico (Flask-Mail) ───────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion_gmail
MAIL_DEFAULT_SENDER=noreply@rossmix.com

# ── Administrador inicial ─────────────────────────────────────
ADMIN_EMAIL=admin@rossmix.com
ADMIN_PASSWORD=cambia_esto_en_produccion

# ── Seeds (credenciales de usuarios de prueba) ───────────────
# Solo para entorno de desarrollo
SEED_ADMIN_PASSWORD=admin123
SEED_CLIENTE_PASSWORD=cliente123

# ── Gunicorn (producción) ─────────────────────────────────────
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# ── Puerto de la app en Docker ────────────────────────────────
APP_PORT=5000
