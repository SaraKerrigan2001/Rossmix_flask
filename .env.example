# ============================================================
# Rossmix Flask — Variables de entorno
# Copia este archivo como ".env" y completa los valores.
# NUNCA subas el archivo ".env" a Git.
# ============================================================

# ── Flask ────────────────────────────────────────────────────
# Genera una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_segura

# ── Base de datos PostgreSQL ─────────────────────────────────
# Opción 1: URI completa (útil en Heroku/Render)
# DATABASE_URL=postgresql+psycopg://usuario:contraseña@host:5432/nombre_bd

# Opción 2: Variables separadas (desarrollo local)
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Rossmix

# ── Usuario administrador por defecto ───────────────────────
# Se crea automáticamente al arrancar si no existe en la BD.
ADMIN_EMAIL=admin@rossmix.com
ADMIN_PASSWORD=cambia_esto_por_password_seguro

# ── Usuarios de prueba (script crear_usuarios.py) ────────────
SEED_ADMIN_PASSWORD=cambia_esto
SEED_CLIENTE_PASSWORD=cambia_esto
